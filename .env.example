# Local defaults work without this file. Copy to .env on a hosted droplet.
POSTGRES_DB=agis_work
POSTGRES_USER=agis
POSTGRES_PASSWORD=replace-with-long-random-password
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=0
SEED_DATA=1
APP_PORT=8000

# Comma-separated hostnames/IPs accepted by Django.
ALLOWED_HOSTS=work.example.org,127.0.0.1
# Include scheme. Comma-separated if more than one.
CSRF_TRUSTED_ORIGINS=https://work.example.org

# Set these when HTTPS terminates at a reverse proxy such as Caddy/Nginx.
TRUST_X_FORWARDED_PROTO=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
